  "glossary": [["yo / tú / me / te",{"fr":"je / tu / me / te","en":"I / you / myself / yourself","es":"yo / tú / me / te"},"words"],["cómo / de dónde / cuántos",{"fr":"comment / d’où / combien","en":"how / where from / how many","es":"cómo / de dónde / cuántos"},"words"],["bien / más o menos / cansada",{"fr":"bien / moyen / fatiguée","en":"well / so-so / tired (feminine)","es":"bien / más o menos / cansada"},"words"],["mucho / gusto / gracias / hasta / luego",{"fr":"beaucoup / plaisir / merci / jusqu’à / plus tard","en":"much / pleasure / thanks / until / later","es":"mucho / gusto / gracias / hasta / luego"},"words"],["de / años",{"fr":"de / ans","en":"from / years","es":"de / años"},"words"],["Canadá / Uruguay / canadiense",{"fr":"Canada / Uruguay / canadien ou canadienne","en":"Canada / Uruguay / Canadian","es":"Canadá / Uruguay / canadiense"},"words"],["llamarse : me llamo / te llamas",{"fr":"s’appeler : je / tu","en":"be called: I / you","es":"llamarse: yo / tú"},"verbs"],["ser : soy / eres; estar : estoy / estás",{"fr":"être (identité); être (état)","en":"be (identity); be (state)","es":"ser (identidad); estar (estado)"},"verbs"],["tener : tengo / tienes",{"fr":"avoir : j’ai / tu as","en":"have: I have / you have","es":"tener: tengo / tienes"},"verbs"],["veinte / veintiún / veintiocho / treinta",{"fr":"20 / 21 devant años / 28 / 30","en":"20 / 21 before años / 28 / 30","es":"20 / 21 delante de años / 28 / 30"},"numbers"],["Nina / Luca / Omar / Sara",{"fr":"Prénoms fictifs","en":"Fictional first names","es":"Nombres ficticios"},"words"]],
  "concepts": [{"title":{"fr":"Présente-toi","en":"Introduce yourself","es":"Preséntate"},"body":{"fr":"« Me llamo » donne ton prénom. « Te llamas » s’adresse à l’autre personne. L’espagnol met un point d’interrogation au début et à la fin d’une question.","en":"“Me llamo” gives your name. “Te llamas” addresses the other person. Spanish questions have an opening and a closing question mark.","es":"«Me llamo» presenta tu nombre. «Te llamas» se refiere a la otra persona. Las preguntas llevan un signo de apertura y otro de cierre."},"examples":["name","ask-name"]},{"title":{"fr":"Prends des nouvelles","en":"Ask how someone is","es":"Pregunta cómo está"},"body":{"fr":"Pour dire comment tu te sens, utilise estar : « estoy bien ». Pour une identité ou une origine, tu verras ser : « soy canadiense ». Nina dit « cansada »; un personnage masculin dirait « cansado ».","en":"Use estar for how you feel: “estoy bien”. Use ser for identity or origin: “soy canadiense”. Nina says “cansada”; a male character would say “cansado”.","es":"Para expresar cómo te sientes, usa estar: «estoy bien». Para la identidad o el origen se usa ser: «soy canadiense». Nina dice «cansada»; un personaje masculino diría «cansado»."},"examples":["how","well","soso","tired"]},{"title":{"fr":"Origine et nationalité","en":"Origin and nationality","es":"Origen y nacionalidad"},"body":{"fr":"« Soy de » introduit l’origine. « Canadiense » ne change pas au masculin et au féminin. Cette mission utilise tú; en Uruguay, tu entendras aussi vos. On découvre les variantes au fil du même parcours.","en":"“Soy de” introduces origin. “Canadiense” has the same masculine and feminine form. This mission uses tú; in Uruguay you will also hear vos. Regional forms belong inside one learning journey.","es":"«Soy de» indica el origen. «Canadiense» tiene la misma forma masculina y femenina. Aquí usamos tú; en Uruguay también oirás vos. Las variantes se descubren dentro de un mismo recorrido."},"examples":["canada","nationality","local"]},{"title":{"fr":"Comprendre un âge","en":"Understand an age","es":"Comprender una edad"},"body":{"fr":"Comme en français, l’âge utilise le verbe avoir : tener. « Tengo » signifie j’ai. Devant años, 21 devient « veintiún » : tengo veintiún años.","en":"Spanish uses tener (“have”) for age: “tengo”. Before años, 21 becomes “veintiún”: tengo veintiún años.","es":"La edad se expresa con tener: «tengo». Delante de años, 21 se convierte en «veintiún»: tengo veintiún años."},"examples":["ask-age","age20","age21","age28","age30"]}],
