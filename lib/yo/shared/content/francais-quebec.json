  "phrases": [["hello","Bonjour !",{"fr":"Bonjour !","en":"Hello!","es":"¡Hola!"},null,null],["name","Je m’appelle Nina.",{"fr":"Je m’appelle Nina.","en":"My name is Nina.","es":"Me llamo Nina."},null,["Je","m’appelle","Nina."]],["ask-name","Comment tu t’appelles ?",{"fr":"Comment t’appelles-tu ?","en":"What is your name?","es":"¿Cómo te llamas?"},null,null],["pleased","Enchantée !",{"fr":"Enchanté / enchantée !","en":"Nice to meet you!","es":"¡Mucho gusto!"},null,null],["how","Comment ça va ?",{"fr":"Comment vas-tu ?","en":"How are you?","es":"¿Cómo estás?"},null,null],["well","Ça va bien, merci.",{"fr":"Je vais bien, merci.","en":"I’m well, thank you.","es":"Estoy bien, gracias."},null,null],["soso","Ça va comme ci, comme ça.",{"fr":"Comme ci, comme ça.","en":"So-so.","es":"Más o menos."},null,null],["tired","Je suis fatiguée.",{"fr":"Je suis fatiguée.","en":"I’m tired.","es":"Estoy cansada."},null,null],["ask-origin","D’où viens-tu ?",{"fr":"D’où viens-tu ?","en":"Where are you from?","es":"¿De dónde eres?"},null,null],["canada","Je viens du Canada.",{"fr":"Je viens du Canada.","en":"I’m from Canada.","es":"Soy de Canadá."},null,["Je","viens","du","Canada."]],["local","Je viens de France.",{"fr":"Je viens de France.","en":"I’m from France.","es":"Soy de Francia."},null,null],["nationality","Je suis canadienne.",{"fr":"Je suis canadienne.","en":"I’m Canadian.","es":"Soy canadiense."},null,null],["ask-age","Quel âge as-tu ?",{"fr":"Quel âge as-tu ?","en":"How old are you?","es":"¿Cuántos años tienes?"},null,null],["age20","J’ai vingt ans.",{"fr":"J’ai vingt ans.","en":"I’m twenty years old.","es":"Tengo veinte años."},null,null],["age21","J’ai vingt et un ans.",{"fr":"J’ai vingt et un ans.","en":"I’m twenty-one years old.","es":"Tengo veintiún años."},null,null],["age28","J’ai vingt-huit ans.",{"fr":"J’ai vingt-huit ans.","en":"I’m twenty-eight years old.","es":"Tengo veintiocho años."},null,["J’ai","vingt-huit","ans."]],["age30","J’ai trente ans.",{"fr":"J’ai trente ans.","en":"I’m thirty years old.","es":"Tengo treinta años."},null,null],["thanks","Merci !",{"fr":"Merci !","en":"Thank you!","es":"¡Gracias!"},null,null],["bye","Au revoir !",{"fr":"Au revoir !","en":"Goodbye!","es":"¡Hasta luego!"},null,null]],
  "glossary": [["je / tu",{"fr":"je / tu","en":"I / you (informal)","es":"yo / tú"},"words"],["comment / où / quel",{"fr":"comment / où / quel","en":"how / where / which","es":"cómo / dónde / cuál"},"words"],["ça / bien / comme ci, comme ça",{"fr":"ça / bien / moyen","en":"it / well / so-so","es":"eso / bien / más o menos"},"words"],["fatiguée / fatigué",{"fr":"au féminin / au masculin","en":"tired (feminine / masculine)","es":"cansada / cansado"},"words"],["de / du",{"fr":"de / de + le","en":"from / de + le","es":"de / de + le"},"words"],["canadienne / canadien",{"fr":"nationalité au féminin / masculin","en":"Canadian (feminine / masculine)","es":"canadiense (femenino / masculino)"},"words"],["Canada / France / âge / ans",{"fr":"Canada / France / âge / années","en":"Canada / France / age / years","es":"Canadá / Francia / edad / años"},"words"],["s’appeler : je m’appelle / tu t’appelles",{"fr":"donner un nom","en":"be called: my name is / your name is","es":"llamarse: me llamo / te llamas"},"verbs"],["être : je suis / tu es; venir : je viens / tu viens",{"fr":"être; venir","en":"be: I am / you are; come: I come / you come","es":"ser: soy / eres; venir: vengo / vienes"},"verbs"],["avoir : j’ai / tu as; aller : ça va",{"fr":"avoir; aller","en":"have: I have / you have; go: it goes","es":"tener: tengo / tienes; ir: va"},"verbs"],["vingt / vingt et un / vingt-huit / trente",{"fr":"20 / 21 / 28 / 30","en":"20 / 21 / 28 / 30","es":"20 / 21 / 28 / 30"},"numbers"],["Nina / Luca / Omar / Sara",{"fr":"Prénoms fictifs","en":"Fictional first names","es":"Nombres ficticios"},"words"]],
  "concepts": [{"title":{"fr":"Présente-toi","en":"Introduce yourself","es":"Preséntate"},"body":{"fr":"Ajoute ton prénom après « Je m’appelle ». « Comment tu t’appelles ? » est courant à l’oral. « Comment t’appelles-tu ? » est une autre façon de poser la même question.","en":"Add your name after “Je m’appelle”. “Comment tu t’appelles ?” is common in speech. “Comment t’appelles-tu ?” asks the same question.","es":"Añade tu nombre después de «Je m’appelle». «Comment tu t’appelles ?» es frecuente al hablar. «Comment t’appelles-tu ?» pregunta lo mismo."},"examples":["name","ask-name"]},{"title":{"fr":"Prends des nouvelles","en":"Ask how someone is","es":"Pregunta cómo está"},"body":{"fr":"« Comment ça va ? » permet de prendre des nouvelles. Le français du Québec utilise ces formes communes; on ne remplace pas chaque mot par de l’argot. « Fatiguée » s’accorde ici avec Nina.","en":"“Comment ça va ?” asks how someone is. Quebec French uses these shared forms; it is not a different word for everything. “Fatiguée” agrees here with Nina.","es":"«Comment ça va ?» pregunta cómo está alguien. El francés de Quebec comparte estas formas; no todo es jerga. «Fatiguée» concuerda aquí con Nina."},"examples":["how","well","soso","tired"]},{"title":{"fr":"Origine et nationalité","en":"Origin and nationality","es":"Origen y nacionalidad"},"body":{"fr":"« Je viens du Canada » donne l’origine. « Je suis canadienne » donne la nationalité. « Du » réunit de + le. On dit « de France », sans le.","en":"“Je viens du Canada” gives origin. “Je suis canadienne” states nationality. “Du” combines de + le; France uses “de France”, without le.","es":"«Je viens du Canada» da el origen. «Je suis canadienne» indica la nacionalidad. «Du» combina de + le. Con Francia se dice «de France», sin le."},"examples":["canada","nationality","local"]},{"title":{"fr":"Comprendre un âge","en":"Understand an age","es":"Comprender una edad"},"body":{"fr":"L’âge se dit avec avoir : « j’ai », « tu as ». Ajoute le nombre puis « ans ». « Vingt et un » contient et, mais « vingt-huit » n’en contient pas.","en":"French uses avoir (“have”) for age: “j’ai”, “tu as”. Add a number, then “ans”. Use “vingt et un” for 21, but “vingt-huit” for 28.","es":"El francés usa avoir para la edad: «j’ai», «tu as». Añade el número y «ans». Se dice «vingt et un» para 21, pero «vingt-huit» para 28."},"examples":["ask-age","age20","age21","age28","age30"]}],
