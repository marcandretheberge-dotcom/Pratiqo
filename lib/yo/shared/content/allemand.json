  "phrases": [["hello","Hallo!",{"fr":"Bonjour !","en":"Hello!","es":"¡Hola!"},null,null],["name","Ich heiße Nora.",{"fr":"Je m’appelle Nora.","en":"My name is Nora.","es":"Me llamo Nora."},null,["Ich","heiße","Nora."]],["ask-name","Wie heißt du?",{"fr":"Comment t’appelles-tu ?","en":"What is your name?","es":"¿Cómo te llamas?"},null,null],["pleased","Freut mich.",{"fr":"Enchanté / enchantée !","en":"Nice to meet you!","es":"¡Mucho gusto!"},null,null],["how","Wie geht es dir?",{"fr":"Comment vas-tu ?","en":"How are you?","es":"¿Cómo estás?"},null,null],["well","Mir geht es gut, danke.",{"fr":"Je vais bien, merci.","en":"I’m well, thank you.","es":"Estoy bien, gracias."},null,null],["soso","Es geht.",{"fr":"Comme ci, comme ça.","en":"So-so.","es":"Más o menos."},null,null],["tired","Ich bin müde.",{"fr":"Je suis fatiguée.","en":"I’m tired.","es":"Estoy cansada."},null,null],["ask-origin","Woher kommst du?",{"fr":"D’où viens-tu ?","en":"Where are you from?","es":"¿De dónde eres?"},null,null],["canada","Ich komme aus Kanada.",{"fr":"Je viens du Canada.","en":"I’m from Canada.","es":"Soy de Canadá."},null,["Ich","komme","aus","Kanada."]],["local","Ich komme aus Deutschland.",{"fr":"Je viens d’Allemagne.","en":"I’m from Germany.","es":"Soy de Alemania."},null,null],["nationality","Ich bin Kanadierin.",{"fr":"Je suis canadienne.","en":"I’m Canadian.","es":"Soy canadiense."},null,null],["ask-age","Wie alt bist du?",{"fr":"Quel âge as-tu ?","en":"How old are you?","es":"¿Cuántos años tienes?"},null,null],["age20","Ich bin zwanzig Jahre alt.",{"fr":"J’ai vingt ans.","en":"I’m twenty years old.","es":"Tengo veinte años."},null,null],["age21","Ich bin einundzwanzig Jahre alt.",{"fr":"J’ai vingt et un ans.","en":"I’m twenty-one years old.","es":"Tengo veintiún años."},null,null],["age28","Ich bin achtundzwanzig Jahre alt.",{"fr":"J’ai vingt-huit ans.","en":"I’m twenty-eight years old.","es":"Tengo veintiocho años."},null,["Ich","bin","achtundzwanzig","Jahre","alt."]],["age30","Ich bin dreißig Jahre alt.",{"fr":"J’ai trente ans.","en":"I’m thirty years old.","es":"Tengo treinta años."},null,null],["thanks","Danke!",{"fr":"Merci !","en":"Thank you!","es":"¡Gracias!"},null,null],["bye","Auf Wiedersehen!",{"fr":"Au revoir !","en":"Goodbye!","es":"¡Hasta luego!"},null,null]],
  "glossary": [["ich / du / mir / dir",{"fr":"je / tu / à moi / à toi","en":"I / you / to me / to you","es":"yo / tú / a mí / a ti"},"words"],["wie / woher / aus",{"fr":"comment / d’où / de","en":"how / where from / from","es":"cómo / de dónde / de"},"words"],["gut / müde / alt",{"fr":"bien / fatigué / âgé","en":"well / tired / old","es":"bien / cansado / de edad"},"words"],["Jahre / Kanada / Deutschland",{"fr":"années / Canada / Allemagne","en":"years / Canada / Germany","es":"años / Canadá / Alemania"},"words"],["Kanadierin / Kanadier",{"fr":"Canadienne / Canadien","en":"Canadian woman / Canadian man","es":"canadiense (mujer / hombre)"},"words"],["heißen : ich heiße / du heißt",{"fr":"s’appeler : je / tu","en":"be called: I / you","es":"llamarse: yo / tú"},"verbs"],["sein : ich bin / du bist",{"fr":"être : je suis / tu es","en":"be: I am / you are","es":"ser: soy / eres"},"verbs"],["kommen : ich komme / du kommst",{"fr":"venir : je / tu","en":"come: I / you","es":"venir: yo / tú"},"verbs"],["geht / es / Freut mich / Auf Wiedersehen",{"fr":"va / cela / enchanté / au revoir","en":"goes / it / nice to meet you / goodbye","es":"va / eso / mucho gusto / hasta luego"},"words"],["zwanzig / einundzwanzig / achtundzwanzig / dreißig",{"fr":"20 / 21 / 28 / 30","en":"20 / 21 / 28 / 30","es":"20 / 21 / 28 / 30"},"numbers"],["Nora / Luca / Omar / Sara",{"fr":"Prénoms fictifs","en":"Fictional first names","es":"Nombres ficticios"},"words"]],
  "concepts": [{"title":{"fr":"Présente-toi","en":"Introduce yourself","es":"Preséntate"},"body":{"fr":"« Ich heiße » donne ton prénom. Pour questionner l’autre personne, utilise « Wie heißt du? ». Ich = je et du = tu. Le verbe change avec la personne.","en":"“Ich heiße” gives your name. Ask the other person with “Wie heißt du?”. Ich means I and du means you. The verb changes with the person.","es":"«Ich heiße» presenta tu nombre. Pregunta con «Wie heißt du?». Ich significa yo y du significa tú. El verbo cambia según la persona."},"examples":["name","ask-name"]},{"title":{"fr":"Prends des nouvelles","en":"Ask how someone is","es":"Pregunta cómo está"},"body":{"fr":"Pour dire que tu vas bien, retiens l’expression « Mir geht es gut ». « Es geht » signifie ici comme ci, comme ça. Pour la fatigue, tu peux dire « Ich bin müde ».","en":"Learn “Mir geht es gut” as an expression meaning I’m well. “Es geht” means so-so here. For tiredness, use “Ich bin müde”.","es":"Aprende «Mir geht es gut» como expresión: estoy bien. Aquí «Es geht» significa más o menos. Para el cansancio se dice «Ich bin müde»."},"examples":["how","well","soso","tired"]},{"title":{"fr":"Origine et nationalité","en":"Origin and nationality","es":"Origen y nacionalidad"},"body":{"fr":"« Aus » annonce l’origine : Ich komme aus Kanada. « Kanadierin » désigne une Canadienne; « Kanadier » un Canadien. Les noms, comme ces nationalités, prennent une majuscule.","en":"“Aus” introduces origin: Ich komme aus Kanada. “Kanadierin” is a Canadian woman; “Kanadier” a Canadian man. These are nouns and take a capital letter.","es":"«Aus» introduce el origen: Ich komme aus Kanada. «Kanadierin» es una canadiense y «Kanadier», un canadiense. Son sustantivos y llevan mayúscula."},"examples":["canada","nationality","local"]},{"title":{"fr":"Comprendre un âge","en":"Understand an age","es":"Comprender una edad"},"body":{"fr":"L’âge utilise sein, être : « ich bin ». Pour 21 et 28, on dit l’unité avant la dizaine : ein-und-zwanzig, acht-und-zwanzig. Le mot s’écrit en un seul bloc.","en":"Age uses sein, “be”: ich bin. In 21 and 28, the unit comes before the tens: ein-und-zwanzig, acht-und-zwanzig. Each number is written as one word.","es":"La edad usa sein, ser: ich bin. Para 21 y 28, la unidad va antes de la decena: ein-und-zwanzig, acht-und-zwanzig. Cada número se escribe en una palabra."},"examples":["ask-age","age20","age21","age28","age30"]}],
