# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
/test-results
/playwright-report
/playwright/.cache
/e2e/.auth

# Next.js
/.next/
/out/

# Production
/build
/dist

# Misc
.DS_Store
Thumbs.db
*.pem
*.p12
*.pfx
*.key
id_rsa
id_dsa
id_ecdsa
id_ed25519
id_rsa.pub
id_dsa.pub
id_ecdsa.pub
id_ed25519.pub

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files (never commit secrets)
.env
.env.local
.env.*.local
.env*.local
.env*
!.env.example

# Vercel / Netlify
.vercel
.netlify

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Local backups & database dumps (never commit)
backups/
dumps/
tmp/
temp/
*.dump
*.sql.gz
*.backup
*.bak
*.sqlite
*.sqlite3
*.db

# Logs
*.log

# Office lock files
**/~$*

# Project ZIP archives (often created before transfers — must not be committed)
/*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Local credential/config files
secrets.*
secret.*
credentials.*
credential.*
service-account.*
google-application-credentials.*
*private-key*
*service-role*
