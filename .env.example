# Next.js
# Copy this file to ".env.local" and fill values.

# Supabase (browser client — see lib/supabase.ts)
# Dashboard: Project Settings → API → Project URL + anon (public) key
# Replace placeholders; the anon key is usually a long JWT (often starts with eyJ...).
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Stripe (server — checkout + webhooks; Connect disabled in checkout for now)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Required for Checkout success/cancel URLs (e.g. https://pratiqo.vercel.app or http://localhost:3000)
STRIPE_CHECKOUT_BASE_URL=
# Service role: server-only (webhook + checkout validation). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional (used elsewhere; checkout uses STRIPE_CHECKOUT_BASE_URL)
NEXT_PUBLIC_SITE_URL=

