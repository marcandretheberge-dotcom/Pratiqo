# =============================================================================
# Pratiqo — environment template
# Copy to ".env.local" and fill values. Never commit ".env.local" or secrets.
# Save ".env.local" as UTF-8 without BOM (some editors add BOM; it can break parsers).
# =============================================================================

# --- App (URLs for links, redirects, Stripe return URLs) ---------------------
# Required for production-like flows: emails, Connect return URL, identity return, etc.
APP_BASE_URL=

# Optional — fallback public site URL (not widely used in code today).
NEXT_PUBLIC_SITE_URL=

# Optional — canonical app URL if you introduce client-side usage (not read by app today).
NEXT_PUBLIC_APP_URL=

# Optional — server-only alias used by some Stripe routes (portal / Pro checkout) before APP_BASE_URL.
APP_URL=

# --- CSP (optional) -----------------------------------------------------------
# Set to 1 before `next build` so the bundle includes Content-Security-Policy-Report-Only
# (stricter candidate policy; enforcing CSP unchanged). Leave empty to omit report-only.
# On Vercel: add to Environment Variables and redeploy. Runtime-only env after build does not toggle this.
ENABLE_CSP_REPORT_ONLY=

# --- Supabase (public — embedded in browser bundle; safe to expose anon key) -
# Required for local dev and Vercel: Auth + data client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — never expose to the browser) --------------------
# Required for server routes using the service role (webhooks, admin queries, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# Optional — verify Supabase Database Webhooks (e.g. review-published) if configured.
SUPABASE_WEBHOOK_SECRET=

# --- Supabase database backup / restore (scripts only) -----------------------
# Optional unless you run scripts/Backup-Database.ps1 or Restore-Database.ps1.
# Use host only for SUPABASE_HOST (no https://). See docs/backup-and-restore.md.
SUPABASE_HOST=
SUPABASE_PORT=
SUPABASE_USER=
SUPABASE_PASSWORD=
# Optional — defaults to "postgres" if omitted. Alternate: POSTGRES_DB.
SUPABASE_DB=
POSTGRES_DB=

# --- Stripe (server-only) ------------------------------------------------------
# Required for payments: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Required for Checkout success/cancel URLs (e.g. https://www.pratiqo.ca or http://localhost:3000).
STRIPE_CHECKOUT_BASE_URL=

# Optional — publishable key for Stripe.js on the client (not read by current codebase; add when wiring Elements).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional — only if you use a separate signing secret for Identity webhooks.
# Default Stripe webhook handler uses STRIPE_WEBHOOK_SECRET for all event types.
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Optional — Stripe Billing price id for teacher Pro plan (see app/api/stripe/pro/checkout).
STRIPE_PRO_MONTHLY_PRICE_ID=

# --- Email (Resend) -----------------------------------------------------------
# Optional — without RESEND_API_KEY, transactional email sends are skipped (non-fatal).
RESEND_API_KEY=

# Optional — "From" is currently hardcoded in lib/email.ts; use this when you make it configurable.
FROM_EMAIL=

# Optional — admin / support notification recipients (see lib/email.ts).
ADMIN_VERIFICATION_EMAIL=
RESEND_ADMIN_EMAIL=
SUPPORT_EMAIL=

# --- AI -----------------------------------------------------------------------
# Optional — required only for /api/ai/description (teacher onboarding bio helper).
ANTHROPIC_API_KEY=

# --- Google Maps (public) -----------------------------------------------------
# Optional — maps on teacher onboarding / search UIs skip or degrade without it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional — display conversion for Uruguay pricing (defaults in code if unset).
NEXT_PUBLIC_UYU_USD_RATE=

# --- Analytics (optional — not wired in codebase today) ----------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Sentry (error tracking + performance) -----------------------------------
# Required for prod error tracking. Without DSN the SDK no-ops silently.
# - NEXT_PUBLIC_SENTRY_DSN is read at runtime by all three Sentry init files
#   (client / server / edge). It's safe to expose — DSNs are public by design.
# - SENTRY_DSN is an optional server-only fallback if you don't want the DSN
#   shipped to the browser. The client config only reads NEXT_PUBLIC_SENTRY_DSN.
# - SENTRY_AUTH_TOKEN is BUILD-TIME ONLY (next.config.ts → withSentryConfig).
#   It uploads source maps + creates releases. Set in Vercel Environment
#   Variables under Production + Preview. Do NOT add it to local .env.local
#   unless you want source maps uploaded from your machine. Scopes needed:
#   project:read, project:releases, org:read.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Optional rate limiting (Upstash Redis REST) -----------------------------
# Omit both to fail open (no Redis calls). See lib/rateLimit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Logging (optional) -------------------------------------------------------
# Set to "1" to allow verbose logInfo in production (see lib/log.ts).
PRATIQO_LOG_INFO=

# --- Demo seed (dev/staging only — NEVER set on production) -------------------
# When "true", lib/seed.ts will upsert hand-crafted demo teachers (lib/dev/demoTeachers.ts)
# and seed two demo student_progress rows on first sign-in. Leave empty in production.
NEXT_PUBLIC_ENABLE_DEMO_SEED=

# --- E2E tests (Playwright) --------------------------------------------------
# Smoke suite under e2e/smoke/ runs without these vars.
# Set the bundle below to activate the journey suite under e2e/journeys/
# (search → book intro → pay → message → review). See e2e/README.md.
E2E_AUTH=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
E2E_TEACHER_EMAIL=
E2E_TEACHER_PASSWORD=
E2E_STRIPE_TEST_CARD=
# Override the Playwright target. When set, the auto-built local web server is skipped.
PLAYWRIGHT_BASE_URL=
