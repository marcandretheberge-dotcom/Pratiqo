# =============================================================================
# Pratiqo — environment template
# Copy to ".env.local" and fill values. Never commit ".env.local" or secrets.
# Save ".env.local" as UTF-8 without BOM (some editors add BOM; it can break parsers).
# =============================================================================

# --- App (URLs for links, redirects, Stripe return URLs) ---------------------
# Required for production-like flows: emails, Connect return URL, identity return, etc.
APP_BASE_URL=

# Optional — fallback public site URL (not widely used in code today).
NEXT_PUBLIC_SITE_URL=

# Optional — canonical app URL if you introduce client-side usage (not read by app today).
NEXT_PUBLIC_APP_URL=

# Optional — server-only alias used by some Stripe routes (portal / Pro checkout) before APP_BASE_URL.
APP_URL=

# --- CSP (optional) -----------------------------------------------------------
# Set to 1 before `next build` so the bundle includes Content-Security-Policy-Report-Only
# (stricter candidate policy; enforcing CSP unchanged). Leave empty to omit report-only.
# On Vercel: add to Environment Variables and redeploy. Runtime-only env after build does not toggle this.
ENABLE_CSP_REPORT_ONLY=

# --- Supabase (public — embedded in browser bundle; safe to expose anon key) -
# Required for local dev and Vercel: Auth + data client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — never expose to the browser) --------------------
# Required for server routes using the service role (webhooks, admin queries, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# Optional — verify Supabase Database Webhooks (e.g. review-published) if configured.
SUPABASE_WEBHOOK_SECRET=

# --- Supabase database backup / restore (scripts only) -----------------------
# Optional unless you run scripts/Backup-Database.ps1 or Restore-Database.ps1.
# Use host only for SUPABASE_HOST (no https://). See docs/backup-and-restore.md.
SUPABASE_HOST=
SUPABASE_PORT=
SUPABASE_USER=
SUPABASE_PASSWORD=
# Optional — defaults to "postgres" if omitted. Alternate: POSTGRES_DB.
SUPABASE_DB=
POSTGRES_DB=

# --- Stripe (server-only) ------------------------------------------------------
# Required for payments: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Required for Checkout success/cancel URLs (e.g. https://www.pratiqo.ca or http://localhost:3000).
STRIPE_CHECKOUT_BASE_URL=

# Optional — publishable key for Stripe.js on the client (not read by current codebase; add when wiring Elements).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional — only if you use a separate signing secret for Identity webhooks.
# Default Stripe webhook handler uses STRIPE_WEBHOOK_SECRET for all event types.
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Optional — Stripe Billing price id for teacher Pro plan (see app/api/stripe/pro/checkout).
STRIPE_PRO_MONTHLY_PRICE_ID=

# Group-session checkout is outside the initial Stripe production launch scope.
GROUP_SESSIONS_CHECKOUT_ENABLED=false

# --- Stripe Tax (individual lesson checkout only; disabled by default) ------------
# When PRATIQO_COLLECT_SALES_TAX=false, checkout and webhooks behave as today (no tax).
PRATIQO_COLLECT_SALES_TAX=false
PRATIQO_TAX_MODE=stripe_tax_inclusive
STRIPE_TAX_CODE_PRIVATE_LESSONS=replace-with-stripe-tax-code
# Optional: required (default) or auto — billing address for Stripe Tax on Checkout.
PRATIQO_TAX_BILLING_ADDRESS_COLLECTION=required

# --- Email (Resend) -----------------------------------------------------------
# Optional — without RESEND_API_KEY, transactional email sends are skipped (non-fatal).
RESEND_API_KEY=

# Optional — "From" is currently hardcoded in lib/email.ts; use this when you make it configurable.
FROM_EMAIL=

# Optional — admin / support notification recipients (see lib/email.ts).
ADMIN_VERIFICATION_EMAIL=
RESEND_ADMIN_EMAIL=
SUPPORT_EMAIL=

# Optional — comma-separated emails granted admin on OAuth login (server-only).
# Does not replace DB role checks; use for initial bootstrap (see lib/auth/admin.ts).
ADMIN_LOGIN_EMAILS=

# --- AI -----------------------------------------------------------------------
# Optional — required only for /api/ai/description (teacher onboarding bio helper).
ANTHROPIC_API_KEY=

# --- YoPratiqo audio (server-only — pre-generated lesson audio pipeline) -----
# Required ONLY for `npm run generate:yopratiqo-audio`. Never expose to the
# browser; the script uploads MP3s to Supabase Storage so the runtime UI never
# calls OpenAI. See docs/yopratiqo-audio.md for the full setup.
OPENAI_API_KEY=

# Optional — override the default Supabase Storage bucket for YoPratiqo audio.
# Defaults to "yopratiqo-audio" (must be public-read + service-role-write only).
YOPRATIQO_AUDIO_BUCKET=

# Optional — override the default OpenAI TTS model / voice used by the script.
# Defaults: model=gpt-4o-mini-tts, voice=alloy.
YOPRATIQO_TTS_MODEL=
YOPRATIQO_TTS_VOICE=

# --- Google Maps (public) -----------------------------------------------------
# Optional — maps on teacher onboarding / search UIs skip or degrade without it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional — display conversion for Uruguay pricing (defaults in code if unset).
NEXT_PUBLIC_UYU_USD_RATE=

# --- Analytics / Observability (optional — wired through lib/analytics + lib/monitoring) -----
# Public PostHog ingest (browser-safe). Helpers in lib/analytics/* no-op
# silently when NEXT_PUBLIC_POSTHOG_KEY is empty. Host defaults to
# https://us.i.posthog.com — set NEXT_PUBLIC_POSTHOG_HOST to override (e.g.
# https://eu.i.posthog.com for the EU region).
# See docs/ANALYTICS_AND_MONITORING.md for the full event taxonomy + privacy
# guardrails (the property sanitizer drops keys matching password/token/
# secret/address/lat/lng/body/content/email/auth/cookie/card/stripe before
# anything leaves the browser).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry DSNs — server vs browser are kept intentionally separate so a
# misconfigured deploy can't leak the server DSN into the client bundle.
# Format: https://<publicKey>@<host>/<projectId>. The minimal capture path
# in lib/monitoring/sentry.ts posts to the Sentry store endpoint via fetch
# (no @sentry/nextjs dependency). When either is empty the capture no-ops.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Server-only: precise teacher weekly time intervals for schedule + booking (defaults OFF).
# When OFF, legacy Matin/Après-midi/Soir blocks remain the source of truth.
ENABLE_TEACHER_SCHEDULE_INTERVALS=

# Client UI: show precise interval editor on /teacher/schedule (defaults OFF).
NEXT_PUBLIC_ENABLE_TEACHER_SCHEDULE_INTERVALS=

# Server-only: date-specific schedule exceptions (defaults OFF).
# When ON: full-day blocks + custom hours (precise mode) override weekly schedule for that date.
ENABLE_TEACHER_SCHEDULE_EXCEPTIONS=

# Client UI: show calendar exception editor on /teacher/schedule (defaults OFF).
# Pair with ENABLE_TEACHER_SCHEDULE_EXCEPTIONS=true so save/delete succeed.
NEXT_PUBLIC_ENABLE_TEACHER_SCHEDULE_EXCEPTIONS=

# Sticky save bar + unsaved-change warnings on teacher schedule (defaults ON; set false to disable).
ENABLE_TEACHER_SCHEDULE_STICKY_SAVE=
NEXT_PUBLIC_ENABLE_TEACHER_SCHEDULE_STICKY_SAVE=

# Optional lightweight auto-save for weekly intervals (defaults OFF — opt-in only).
ENABLE_TEACHER_SCHEDULE_AUTOSAVE=
NEXT_PUBLIC_ENABLE_TEACHER_SCHEDULE_AUTOSAVE=

# Interactive Matin/Après-midi/Soir cells with precise interval editor (defaults ON).
# Set NEXT_PUBLIC_*=false or ENABLE_*=false to force legacy broad toggles / block saves.
# Booking still requires ENABLE_TEACHER_SCHEDULE_INTERVALS (global) or per-teacher
# schedule_mode=precise_intervals when ENABLE_TEACHER_PRECISE_SCHEDULE_BOOKING is ON.
ENABLE_TEACHER_SCHEDULE_INTERACTIVE_CELLS=
NEXT_PUBLIC_ENABLE_TEACHER_SCHEDULE_INTERACTIVE_CELLS=

# Server-only: per-teacher precise schedule as booking source of truth (defaults OFF).
# QA / launch checklist for precise booking:
#   1) ENABLE_TEACHER_PRECISE_SCHEDULE_BOOKING=true
#   2) NEXT_PUBLIC_ENABLE_TEACHER_PRECISE_SCHEDULE_BOOKING=true (Horaire status + Activate)
#   3) Teacher saves intervals, then activates → schedule_mode=precise_intervals
# When ON, only teachers with schedule_mode=precise_intervals use exact intervals;
# legacy_blocks teachers keep Matin/Après-midi/Soir booking behavior.
# (ENABLE_TEACHER_SCHEDULE_INTERVALS alone still forces intervals for ALL teachers —
#  leave it OFF when using per-teacher precise booking.)
ENABLE_TEACHER_PRECISE_SCHEDULE_BOOKING=

# Client UI: show activate / status controls for precise schedule on Horaire (defaults OFF).
NEXT_PUBLIC_ENABLE_TEACHER_PRECISE_SCHEDULE_BOOKING=

# Server-only: teacher Horaire booking preview “what learners can book” (defaults OFF).
ENABLE_TEACHER_AVAILABILITY_PREVIEW=

# Client UI: show availability preview section on /teacher/schedule (defaults OFF).
NEXT_PUBLIC_ENABLE_TEACHER_AVAILABILITY_PREVIEW=

# Preview-only offer selection in BookingModal (defaults OFF).
NEXT_PUBLIC_ENABLE_BOOKING_OFFER_SELECTION=

# Server-only: charge Stripe checkout from booking offer snapshots (defaults OFF).
ENABLE_OFFER_SNAPSHOT_CHECKOUT=

# Client UI copy when offer selection + snapshot checkout are both enabled.
NEXT_PUBLIC_ENABLE_OFFER_SNAPSHOT_CHECKOUT=

# Phase 1 planned packages skeleton: teacher draft UI only (defaults OFF).
# Does not enable public purchase, entitlements, or payouts.
ENABLE_PLANNED_PACKAGES=
NEXT_PUBLIC_ENABLE_PLANNED_PACKAGES=

# Server-only: create package (forfait) entitlements after paid package checkout (defaults OFF).
# Package snapshot checkout also requires ENABLE_OFFER_SNAPSHOT_CHECKOUT=true.
ENABLE_PACKAGE_ENTITLEMENTS=

# Server-only: redeem a package session into a booking without Stripe (defaults OFF).
ENABLE_PACKAGE_REDEMPTION_BOOKING=

# Client UI: show “Utiliser une séance du forfait” in BookingModal (defaults OFF).
NEXT_PUBLIC_ENABLE_PACKAGE_REDEMPTION_BOOKING=

# Server-only: student “Mes forfaits” dashboard API (defaults OFF).
ENABLE_STUDENT_PACKAGE_DASHBOARD=

# Client UI: show “Mes forfaits” nav + /student/packages (defaults OFF).
NEXT_PUBLIC_ENABLE_STUDENT_PACKAGE_DASHBOARD=

# Server-only: teacher “Forfaits” package visibility API (defaults OFF).
ENABLE_TEACHER_PACKAGE_VISIBILITY=

# Client UI: show teacher “Forfaits” nav + /teacher/packages (defaults OFF).
NEXT_PUBLIC_ENABLE_TEACHER_PACKAGE_VISIBILITY=

# Server-only: policy-aware package-credit cancellation (PR 16B). Defaults OFF.
# When OFF, PR 10C always restores package credit on cancel. When ON, student
# cancellations use booking cancellation preference snapshots.
ENABLE_OFFER_POLICY_ENFORCEMENT=

# Client UI: show package policy cancel hints (defaults OFF). Does not authorize server.
NEXT_PUBLIC_ENABLE_OFFER_POLICY_ENFORCEMENT=

# Ops-only signal for /admin/package-launch-readiness (defaults OFF).
# Set true only after Québec counsel sign-off. Does not enable package flags.
PACKAGE_LEGAL_REVIEW_COMPLETED=

# --- Optional rate limiting (Upstash Redis REST) -----------------------------
# Omit both to fail open (no Redis calls). See lib/rateLimit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Logging (optional) -------------------------------------------------------
# Set to "1" to allow verbose logInfo in production (see lib/log.ts).
PRATIQO_LOG_INFO=

# --- Vercel ops (scripts only — never commit real tokens) --------------------
# Required for `npm run configure:apex-redirect` (scripts/configure_vercel_apex_permanent_redirect.ts).
# Creates/verifies the project-domain redirect pratiqo.ca → www.pratiqo.ca with status 308.
VERCEL_TOKEN=
# Optional overrides (public defaults match production):
# VERCEL_PROJECT_SLUG=pratiqo
# VERCEL_APEX_DOMAIN=pratiqo.ca
# VERCEL_CANONICAL_DOMAIN=www.pratiqo.ca
