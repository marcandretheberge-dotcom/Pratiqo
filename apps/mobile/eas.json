{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "node": "22.13.0"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_NATIVE_MODE": "isolated",
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SUPABASE_URL": "disabled-in-isolated-preview",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "disabled-in-isolated-preview",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "disabled-in-isolated-preview"
      },
      "node": "22.13.0"
    },
    "production": {
      "environment": "production",
      "env": { "EXPO_PUBLIC_NATIVE_MODE": "production" },
      "autoIncrement": true,
      "node": "22.13.0"
    }
  },
  "submit": {
    "production": {}
  }
}
