{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["student", "teacher"] },
        "photoUrl": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Information about a teacher",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "discipline": { "type": "string" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "reviews": { "type": "number" },
        "pricePerLesson": { "type": "number" },
        "monthlySubscription": { "type": "number" },
        "bio": { "type": "string" },
        "imageUrl": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "availability": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["userId", "name", "discipline", "category", "pricePerLesson", "location"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A lesson reservation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["booked", "completed", "cancelled"] },
        "price": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "studentId", "date", "time", "status", "price"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A conversation between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["participantIds"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] }
      },
      "required": ["chatId", "senderId", "text", "timestamp"]
    },
    "Progress": {
      "title": "Progress",
      "description": "Student progress tracking entry",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "subject": { "type": "string" },
        "score": { "type": "number" },
        "notes": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "achievements": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["studentId", "teacherId", "subject", "score", "date"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "A task or homework assigned by a teacher to a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "studentId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "submitted", "reviewed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "feedback": { "type": "string" }
      },
      "required": ["teacherId", "studentId", "title", "status", "createdAt"]
    },
    "PratiqoNotification": {
      "title": "PratiqoNotification",
      "description": "Real-time user notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["booking", "message", "assignment", "system"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "link": { "type": "string" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Store user profiles"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Store teacher profiles and listings"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Store lesson reservations"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Store chat metadata"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Store messages within a chat"
    },
    "/student_progress/{progressId}": {
      "schema": "Progress",
      "description": "Store student progress tracking entries"
    },
    "/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Store tasks assigned to students"
    },
    "/notifications/{notificationId}": {
      "schema": "PratiqoNotification",
      "description": "Store user real-time notifications"
    }
  }
}
