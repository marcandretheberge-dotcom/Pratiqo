rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isVerified() { return request.auth.token.email_verified == true; }

    // Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) 
        && data.keys().size() == 4
        && data.id == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.role in ['student', 'teacher'];
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['userId', 'name', 'discipline', 'category', 'pricePerLesson', 'location', 'bio', 'imageUrl', 'rating', 'reviews', 'availability'])
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.discipline is string && data.discipline.size() <= 100
        && data.category is string && data.category.size() <= 50
        && data.pricePerLesson is number && data.pricePerLesson >= 0
        && data.location is map && data.location.lat is number && data.location.lng is number;
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['teacherId', 'studentId', 'date', 'time', 'status', 'price', 'createdAt'])
        && data.studentId == request.auth.uid
        && data.status in ['booked', 'completed', 'cancelled']
        && data.price is number && data.price >= 0
        && data.createdAt == request.time;
    }

    function isValidChat(data) {
      return data.participantIds is list 
        && data.participantIds.size() == 2
        && request.auth.uid in data.participantIds;
    }

    function isValidMessage(data) {
      return data.chatId is string
        && data.senderId == request.auth.uid
        && data.text is string && data.text.size() > 0 && data.text.size() <= 5000
        && data.timestamp == request.time;
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['studentId', 'teacherId', 'subject', 'score', 'date', 'notes', 'achievements'])
        && data.teacherId == request.auth.uid
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.date == request.time;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(['teacherId', 'studentId', 'title', 'status', 'createdAt'])
        && data.teacherId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.status in ['pending', 'submitted', 'reviewed']
        && data.createdAt == request.time;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt'])
        && data.userId is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 500
        && data.type in ['booking', 'message', 'assignment', 'system']
        && data.read is bool
        && data.createdAt == request.time;
    }

    // Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoUrl']);
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow create: if isOwner(incoming().userId) && isValidTeacher(incoming());
      allow update: if isOwner(existing().userId) && isValidTeacher(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['discipline', 'category', 'pricePerLesson', 'bio', 'imageUrl', 'location', 'availability', 'rating', 'reviews']);
    }

    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (isOwner(existing().studentId) || isOwner(existing().teacherId));
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid);
      allow create: if isSignedIn() && isValidBooking(incoming()) && isValidId(bookingId);
      allow update: if isSignedIn() && (isOwner(existing().studentId) || isOwner(existing().teacherId))
        && incoming().status in ['completed', 'cancelled']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    match /chats/{chatId} {
      allow get: if isSignedIn() && request.auth.uid in existing().participantIds;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && isValidChat(incoming()) && isValidId(chatId);
      allow update: if isSignedIn() && request.auth.uid in existing().participantIds
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastTimestamp']);

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && isValidMessage(incoming()) && isValidId(messageId);
      }
    }

    match /student_progress/{progressId} {
      allow read: if isSignedIn() && (isOwner(existing().studentId) || isOwner(existing().teacherId));
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid);
      allow create: if isSignedIn() && isValidProgress(incoming()) && isValidId(progressId);
      allow update: if isSignedIn() && isOwner(existing().teacherId) && isValidProgress(incoming())
        && incoming().studentId == existing().studentId
        && incoming().diff(existing()).affectedKeys().hasOnly(['score', 'notes', 'achievements']);
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (resource == null || isOwner(existing().studentId) || isOwner(existing().teacherId));
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid);
      allow create: if isSignedIn() && isValidAssignment(incoming()) && isValidId(assignmentId);
      allow update: if isSignedIn() && (isOwner(existing().studentId) || isOwner(existing().teacherId))
        && (
          (isOwner(existing().teacherId) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'dueDate', 'feedback', 'status'])) ||
          (isOwner(existing().studentId) && incoming().status == 'submitted' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))
        );
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidNotification(incoming()) && isValidId(notificationId);
      allow update: if isSignedIn() && isOwner(existing().userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
