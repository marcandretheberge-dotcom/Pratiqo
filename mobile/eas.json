{
  "cli": { "version": ">= 25.2.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "environment": "development" },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "beta": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  }
}
