<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="400" height="300" name="Yoppo Eye Tooling Spike" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <Fill name="Background">
            <SolidColor colorValue="FFF4F0E8" name="Color"/>
        </Fill>

        <!-- Visible eye surface. -->
        <Shape x="200" y="120" name="Eye White" id="0:20">
            <Ellipse width="150" height="110" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="FFFDF7EC" name="Cream"/>
            </Fill>
        </Shape>

        <!-- Exact documented per-shape clipping pattern. -->
        <Shape x="200" y="120" name="Pupil" id="0:21">
            <Ellipse x="-20" y="5" width="62" height="78" name="Path" id="0:23"/>
            <Fill name="Fill">
                <SolidColor colorValue="FF045A55" name="Dark teal"/>
            </Fill>
            <ClippingShape sourceId="0:50" name="Eye Clip"/>
        </Shape>

        <Shape x="200" y="120" name="Catchlight" id="0:22">
            <Ellipse x="-32" y="-18" width="15" height="15" name="Path" id="0:24"/>
            <Fill name="Fill">
                <SolidColor colorValue="FFFFFFFF" name="White"/>
            </Fill>
            <ClippingShape sourceId="0:50" name="Eye Clip"/>
        </Shape>

        <Shape x="200" y="120" name="Upper Lid" id="0:30">
            <PointsPath isClosed="true" name="Lid Path" id="0:31">
                <StraightVertex x="-78" y="-58" name="Lid TL" id="0:32"/>
                <StraightVertex x="78" y="-58" name="Lid TR" id="0:33"/>
                <StraightVertex x="78" y="-32" name="Lid BR" id="0:34"/>
                <StraightVertex x="-78" y="-32" name="Lid BL" id="0:35"/>
            </PointsPath>
            <Fill name="Fill">
                <SolidColor colorValue="FFFDF7EC" name="Cream"/>
            </Fill>
            <ClippingShape sourceId="0:50" name="Eye Clip"/>
        </Shape>

        <!-- Geometry-only clipping source. Rive's own docs place the source after the clipped drawables. -->
        <Shape x="200" y="120" name="Eye Mask" id="0:50">
            <Ellipse width="150" height="110" name="Mask Path"/>
        </Shape>

        <!-- Independent animation control: proves headless --advance changes the frame. -->
        <Shape x="330" y="46" name="Motion Control" id="0:40">
            <Rectangle width="18" height="18" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="FF04ABA4" name="Teal"/>
            </Fill>
        </Shape>

        <!-- Executable vector-rig proof: two-bone IK + skinned PointsPath. -->
        <Node x="72" y="245" name="Vector Skin Proof" id="0:60">
            <RootBone x="0" y="0" length="48" rotation="0" name="Upper" id="0:61">
                <Bone length="48" rotation="0" name="Fore" id="0:62">
                    <IKConstraint targetId="0:63" parentBoneCount="1" strength="1" name="Two Bone IK"/>
                </Bone>
            </RootBone>
            <Node x="82" y="-34" name="IK Target" id="0:63"/>

            <Shape name="Skinned Ribbon" id="0:70">
                <PointsPath isClosed="true" name="Ribbon Path" id="0:71">
                    <StraightVertex x="0" y="-8" name="V0">
                        <Weight values="255" indices="1"/>
                    </StraightVertex>
                    <StraightVertex x="44" y="-8" name="V1">
                        <Weight values="255" indices="1"/>
                    </StraightVertex>
                    <StraightVertex x="96" y="-8" name="V2">
                        <Weight values="255" indices="2"/>
                    </StraightVertex>
                    <StraightVertex x="96" y="8" name="V3">
                        <Weight values="255" indices="2"/>
                    </StraightVertex>
                    <StraightVertex x="44" y="8" name="V4">
                        <Weight values="255" indices="1"/>
                    </StraightVertex>
                    <StraightVertex x="0" y="8" name="V5">
                        <Weight values="255" indices="1"/>
                    </StraightVertex>
                    <Skin tx="0" ty="0" name="Ribbon Skin">
                        <Tendon boneId="0:61" tx="0" ty="0" name="Upper Tendon"/>
                        <Tendon boneId="0:62" tx="48" ty="0" name="Fore Tendon"/>
                    </Skin>
                </PointsPath>
                <Fill name="Fill">
                    <SolidColor colorValue="FF04ABA4" name="Teal"/>
                </Fill>
            </Shape>
        </Node>

        <StateMachine name="Tooling Proof" id="0:7">
            <StateMachineLayer name="Loop" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:12"/>
                </EntryState>
                <AnimationState x="200" animationId="0:6" id="0:12"/>
            </StateMachineLayer>
        </StateMachine>

        <LinearAnimation loopValue="loop" fps="60" duration="60" name="Eye Motion Proof" id="0:6">
            <KeyedObject objectId="0:23">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="-20" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="46" frame="30" interpolationType="linear"/>
                    <KeyFrameDouble value="-20" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>

            <KeyedObject objectId="0:24">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="-32" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="12" frame="30" interpolationType="linear"/>
                    <KeyFrameDouble value="-32" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- True path morph: same vertex ids/topology, only vertex y changes. -->
            <KeyedObject objectId="0:34">
                <KeyedProperty propertyKey="25">
                    <KeyFrameDouble value="-32" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-32" frame="20" interpolationType="linear"/>
                    <KeyFrameDouble value="38" frame="30" interpolationType="linear"/>
                    <KeyFrameDouble value="-32" frame="40" interpolationType="linear"/>
                    <KeyFrameDouble value="-32" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:35">
                <KeyedProperty propertyKey="25">
                    <KeyFrameDouble value="-32" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="-32" frame="20" interpolationType="linear"/>
                    <KeyFrameDouble value="38" frame="30" interpolationType="linear"/>
                    <KeyFrameDouble value="-32" frame="40" interpolationType="linear"/>
                    <KeyFrameDouble value="-32" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>

            <KeyedObject objectId="0:40">
                <KeyedProperty propertyKey="13">
                    <KeyFrameDouble value="330" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="360" frame="30" interpolationType="linear"/>
                    <KeyFrameDouble value="330" frame="60" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>
</Rive>
